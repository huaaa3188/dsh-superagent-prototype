#!/usr/bin/env node
/**
 * gcal-cli: Controlled Calendar & GTD CLI for Project Aura (dsh-superagent).
 *
 * Supports dual backends:
 *   1. Google Calendar REST API v3 (OAuth2 Refresh Token / Access Token / Service Account RS256 JWT)
 *      with automatic exponential backoff retry on network jitter, 429, and 5xx errors.
 *   2. Local JSON store fallback (<AURA_DATA_DIR>/calendar-gtd.json) when no cloud credentials are set.
 *
 * Permission Tiers:
 *   L1 (Read-only):
 *     gcal-cli list [--date YYYY-MM-DD]
 *     gcal-cli conflicts [--date YYYY-MM-DD]
 *     gcal-cli gtd-list [--status todo|done|all]
 *   L2 (Reversible Drafts & GTD):
 *     gcal-cli draft-add --title <text> --start <HH:MM> --end <HH:MM> [--date YYYY-MM-DD] [--location <loc>]
 *     gcal-cli gtd-add --title <text> [--priority high|medium|low] [--due YYYY-MM-DD]
 *     gcal-cli gtd-done --id <todoId>
 *   L3 (Irreversible / External Mutations — requires human approval token/confirmation):
 *     gcal-cli commit-draft --draft-id <id> --approved-by <triggerOrCallback>
 *     gcal-cli reschedule --event-id <id> --start <HH:MM> --end <HH:MM> --approved-by <triggerOrCallback>
 *     gcal-cli delete --event-id <id> --approved-by <triggerOrCallback>
 */
import { createSign } from 'node:crypto'
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { join } from 'node:path'
import { consumeApproval } from './approval.mjs'

const dataDir = process.env.AURA_DATA_DIR || join(homedir(), '.dsh', 'state', 'superagent', 'aura-data')
const storePath = join(dataDir, 'calendar-gtd.json')
const gcalConfigPath = process.env.AURA_GCAL_CONFIG || join(homedir(), '.config', 'aura-agent', 'gcal.json')

const todayStr = () => new Date().toISOString().slice(0, 10)

function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms))
}

