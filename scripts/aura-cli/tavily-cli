#!/usr/bin/env node
/**
 * tavily-cli: Controlled Web Research CLI for Project Aura (dsh-superagent).
 *
 * Subcommands (L1 Read-only):
 *   tavily-cli search --query <text> [--max-results <n>]
 *
 * Uses TAVILY_API_KEY (or ~/.config/aura-agent/tavily.json) when configured;
 * otherwise falls back to Wikipedia/DuckDuckGo Instant Answer JSON APIs for structured research.
 */
import { existsSync, readFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { join } from 'node:path'

function parseArgs(argv) {
  const cmd = argv[2] || ''
  const flags = {}
  for (let i = 3; i < argv.length; i++) {
    const arg = argv[i]
    if (arg.startsWith('--')) {
      const key = arg.slice(2)
      const next = argv[i + 1]
      if (next === undefined || next.startsWith('--')) {
        flags[key] = true
      } else {
        flags[key] = next
        i++
      }
    }
  }
  return { cmd, flags }
}

function loadApiKey() {
  if (process.env.TAVILY_API_KEY) return process.env.TAVILY_API_KEY
  const cfgPath = join(homedir(), '.config', 'aura-agent', 'tavily.json')
  try {
    if (existsSync(cfgPath)) return JSON.parse(readFileSync(cfgPath, 'utf8')).apiKey
  } catch {
    // ignore
  }
  return undefined
}

async function main() {
  const { cmd, flags } = parseArgs(process.argv)
  if (cmd !== 'search') {
    process.stderr.write(JSON.stringify({ error: { code: 400, message: 'Usage: tavily-cli search --query <text> [--max-results <n>]' } }) + '\n')
    process.exit(1)
  }
  const query = String(flags.query || '').trim()
  const maxResults = Number(flags['max-results'] || 5)
  if (!query) {
    process.stderr.write(JSON.stringify({ error: { code: 400, message: 'Missing --query' } }) + '\n')
    process.exit(1)
  }

  const apiKey = loadApiKey()
  if (apiKey) {
    const res = await fetch('https://api.tavily.com/search', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ api_key: apiKey, query, max_results: maxResults, include_answer: true }),
      signal: AbortSignal.timeout(15000),
    })
    const data = await res.json()
    process.stdout.write(JSON.stringify({ provider: 'tavily', query, answer: data.answer, results: data.results || [] }) + '\n')
    return
  }

  // Fallback structured search via Wikipedia OpenSearch API
  const url = `https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(query)}&utf8=&format=json&srlimit=${maxResults}`
  try {
    const res = await fetch(url, { signal: AbortSignal.timeout(8000) })
    const data = await res.json()
    const items = (data?.query?.search || []).map(item => ({
      title: item.title,
      url: `https://en.wikipedia.org/wiki/${encodeURIComponent(item.title.replace(/ /g, '_'))}`,
      snippet: String(item.snippet || '').replace(/<[^>]+>/g, ''),
    }))
    process.stdout.write(JSON.stringify({ provider: 'wikipedia-fallback', query, results: items }) + '\n')
  } catch (err) {
    process.stdout.write(JSON.stringify({ provider: 'offline-fallback', query, results: [], note: String(err) }) + '\n')
  }
}

main()
